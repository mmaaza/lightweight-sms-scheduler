# Application Configuration
PORT=3009
DATABASE_URL="postgresql://user:password@localhost:5432/sms_scheduler?schema=public"

# ==========================================
# SMS Provider Configuration
# ==========================================
# Options: "mock", "api", "webhook"
# - mock: Simulates sending SMS (logs to console, no real SMS sent). Good for local dev.
# - api: Sends real SMS via a generic HTTP API (configured below).
# - webhook: Sends a POST request to a webhook URL.
SMS_PROVIDER="mock"

# ==========================================
# Generic API Provider Configuration (for SMS_PROVIDER="api")
# ==========================================

# 1. The full URL endpoint of your SMS provider.
#    You can use template variables here for GET requests.
#    Example: "https://api.example.com/send?phone={{to}}&msg={{body_url_encoded}}"
# SMS_API_URL="https://api.example.com/send"

# 2. The HTTP method to use (GET, POST, PUT, etc.)
# SMS_API_METHOD="POST"

# 3. HTTP Headers as a JSON string.
#    Common for Auth tokens or Content-Type.
#    Example: '{"Authorization": "Bearer my-token", "Content-Type": "application/json"}'
# SMS_API_HEADERS='{"Content-Type": "application/json"}'

# 4. Request Body Template.
#    This is the payload sent to the API (ignored for GET/HEAD).
#    Available variables:
#      - {{to}}: The phone number/recipient (raw)
#      - {{body}}: The message content (raw)
#      - {{to_url_encoded}}: URL-encoded phone number
#      - {{body_url_encoded}}: URL-encoded message content (Essential for x-www-form-urlencoded or query params)
#    
#    Example (JSON): '{"phone": "{{to}}", "message": "{{body}}"}'
#    Example (Form): "to={{to}}&text={{body_url_encoded}}"
# SMS_API_BODY_TEMPLATE='{"to": "{{to}}", "body": "{{body}}"}'

# ==========================================
# Webhook Provider Configuration (for SMS_PROVIDER="webhook")
# ==========================================
# SMS_WEBHOOK_URL="https://your-webhook-endpoint.com/sms"
# SMS_WEBHOOK_TOKEN="optional-bearer-token"
